{
  "schema": "marty.issuance-static-discovery/v1",
  "inputs": {
    "issuer_base_url": "https://issuer.example",
    "issuer_display_name": "Example Issuer",
    "organization_id": "org-a",
    "credential_type": "access_badge"
  },
  "transport": {
    "request_id": {
      "request_header": "x-request-id",
      "response_header": "x-request-id",
      "propagated_value": "contract-request-id",
      "generated_pattern": "^[0-9a-f]{8}$",
      "empty_value_generates": true
    },
    "cors": {
      "environment_variable": "CORS_ALLOWED_ORIGINS",
      "default_allowed_origins": [
        "http://localhost:3000"
      ],
      "allowed_methods": [
        "DELETE",
        "GET",
        "HEAD",
        "OPTIONS",
        "PATCH",
        "POST",
        "PUT"
      ],
      "allowed_origin": "https://wallet.example",
      "simple_response_headers": {
        "access-control-allow-credentials": "true",
        "access-control-allow-origin": "https://wallet.example",
        "vary": "Origin"
      },
      "wildcard_simple_request": {
        "configured_origin": "*",
        "request_origin": "https://any-wallet.example",
        "response_headers": {
          "access-control-allow-credentials": "true",
          "access-control-allow-origin": "https://any-wallet.example",
          "vary": "Origin"
        }
      },
      "preflight": {
        "method": "OPTIONS",
        "path": "/.well-known/oauth-authorization-server",
        "request_headers": {
          "origin": "https://wallet.example",
          "access-control-request-method": "GET",
          "access-control-request-headers": "X-Wallet-Test",
          "x-request-id": "preflight-request"
        },
        "status_code": 200,
        "response_headers": {
          "vary": "Origin",
          "access-control-allow-methods": "DELETE, GET, HEAD, OPTIONS, PATCH, POST, PUT",
          "access-control-max-age": "600",
          "access-control-allow-credentials": "true",
          "access-control-allow-origin": "https://wallet.example",
          "access-control-allow-headers": "X-Wallet-Test",
          "content-type": "text/plain; charset=utf-8",
          "x-request-id": "preflight-request"
        },
        "body": "OK"
      },
      "denied_preflight": {
        "method": "OPTIONS",
        "path": "/.well-known/oauth-authorization-server",
        "request_headers": {
          "origin": "https://evil.example",
          "access-control-request-method": "GET",
          "x-request-id": "denied-request"
        },
        "status_code": 400,
        "response_headers": {
          "vary": "Origin",
          "access-control-allow-methods": "DELETE, GET, HEAD, OPTIONS, PATCH, POST, PUT",
          "access-control-max-age": "600",
          "access-control-allow-credentials": "true",
          "content-type": "text/plain; charset=utf-8",
          "x-request-id": "denied-request"
        },
        "body": "Disallowed CORS origin"
      },
      "denied_method_preflight": {
        "method": "OPTIONS",
        "path": "/.well-known/oauth-authorization-server",
        "request_headers": {
          "origin": "https://wallet.example",
          "access-control-request-method": "TRACE",
          "x-request-id": "denied-method-request"
        },
        "status_code": 400,
        "response_headers": {
          "vary": "Origin",
          "access-control-allow-methods": "DELETE, GET, HEAD, OPTIONS, PATCH, POST, PUT",
          "access-control-max-age": "600",
          "access-control-allow-credentials": "true",
          "access-control-allow-origin": "https://wallet.example",
          "content-type": "text/plain; charset=utf-8",
          "x-request-id": "denied-method-request"
        },
        "body": "Disallowed CORS method"
      }
    }
  },
  "cases": [
    {
      "operation": "get_issuer_metadata_root",
      "method": "GET",
      "path": "/.well-known/openid-credential-issuer",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "credential_issuer": "https://issuer.example",
        "authorization_servers": [
          "https://issuer.example"
        ],
        "display": [
          {
            "name": "Example Issuer",
            "locale": "en-US"
          }
        ],
        "credential_endpoint": "https://issuer.example/v1/issuance/credential",
        "nonce_endpoint": "https://issuer.example/v1/issuance/nonce",
        "deferred_credential_endpoint": "https://issuer.example/v1/issuance/deferred-credential",
        "notification_endpoint": "https://issuer.example/v1/issuance/notification",
        "credential_configurations_supported": {
          "default": {
            "format": "jwt_vc_json",
            "scope": "default",
            "cryptographic_binding_methods_supported": [
              "did:key",
              "jwk"
            ],
            "credential_signing_alg_values_supported": [
              "ES256",
              "EdDSA"
            ],
            "proof_types_supported": {
              "jwt": {
                "proof_signing_alg_values_supported": [
                  "ES256",
                  "EdDSA"
                ],
                "key_attestations_required": {}
              }
            },
            "credential_definition": {
              "type": [
                "VerifiableCredential"
              ]
            },
            "credential_metadata": {
              "display": [
                {
                  "name": "Verifiable Credential",
                  "locale": "en-US"
                }
              ]
            }
          },
          "default#credential-manager": {
            "format": "dc+sd-jwt",
            "scope": "default",
            "vct": "https://issuer.example/credentials/default",
            "cryptographic_binding_methods_supported": [
              "did:key",
              "jwk"
            ],
            "credential_signing_alg_values_supported": [
              "ES256",
              "EdDSA"
            ],
            "proof_types_supported": {
              "jwt": {
                "proof_signing_alg_values_supported": [
                  "ES256",
                  "EdDSA"
                ],
                "key_attestations_required": {}
              }
            },
            "credential_metadata": {
              "display": [
                {
                  "name": "Verifiable Credential (SD-JWT)",
                  "locale": "en-US"
                }
              ]
            }
          },
          "default#ldp-vc": {
            "format": "ldp_vc",
            "scope": "default",
            "cryptographic_binding_methods_supported": [
              "did:key",
              "jwk"
            ],
            "credential_signing_alg_values_supported": [
              "eddsa-rdfc-2022"
            ],
            "proof_types_supported": {
              "jwt": {
                "proof_signing_alg_values_supported": [
                  "ES256",
                  "EdDSA"
                ],
                "key_attestations_required": {}
              }
            },
            "credential_definition": {
              "@context": [
                "https://www.w3.org/ns/credentials/v2"
              ],
              "type": [
                "VerifiableCredential"
              ]
            },
            "credential_metadata": {
              "display": [
                {
                  "name": "Verifiable Credential (Data Integrity)",
                  "locale": "en-US"
                }
              ]
            }
          },
          "default#mdoc": {
            "format": "mso_mdoc",
            "scope": "default",
            "doctype": "org.iso.18013.5.1.mDL",
            "cryptographic_binding_methods_supported": [
              "did:key",
              "jwk"
            ],
            "credential_signing_alg_values_supported": [
              -7,
              -8
            ],
            "proof_types_supported": {
              "jwt": {
                "proof_signing_alg_values_supported": ["ES256"],
                "key_attestations_required": {}
              }
            },
            "credential_metadata": {
              "display": [
                {
                  "name": "Mobile Document (mDL)",
                  "locale": "en-US"
                }
              ]
            }
          }
        }
      }
    },
    {
      "operation": "get_sd_jwt_vc_type_metadata",
      "method": "GET",
      "path": "/credentials/access_badge",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "vct": "https://issuer.example/credentials/access_badge",
        "name": "Access Badge",
        "display": [
          {
            "name": "Access Badge",
            "locale": "en-US"
          }
        ]
      }
    },
    {
      "operation": "get_as_metadata",
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "issuer": "https://issuer.example",
        "authorization_endpoint": "https://issuer.example/v1/issuance/authorize",
        "token_endpoint": "https://issuer.example/v1/issuance/token",
        "pushed_authorization_request_endpoint": "https://issuer.example/v1/issuance/par",
        "token_endpoint_auth_methods_supported": [
          "none"
        ],
        "grant_types_supported": [
          "urn:ietf:params:oauth:grant-type:pre-authorized_code",
          "authorization_code"
        ],
        "response_types_supported": [
          "code"
        ],
        "code_challenge_methods_supported": [
          "S256"
        ],
        "pre-authorized_grant_anonymous_access_supported": true
      }
    },
    {
      "operation": "get_org_as_metadata",
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server/org/org-a",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "issuer": "https://issuer.example/org/org-a",
        "authorization_endpoint": "https://issuer.example/v1/issuance/authorize?issuer_org=org-a",
        "token_endpoint": "https://issuer.example/v1/issuance/token",
        "pushed_authorization_request_endpoint": "https://issuer.example/v1/issuance/par?issuer_org=org-a",
        "token_endpoint_auth_methods_supported": [
          "none",
          "private_key_jwt"
        ],
        "token_endpoint_auth_signing_alg_values_supported": [
          "ES256"
        ],
        "grant_types_supported": [
          "urn:ietf:params:oauth:grant-type:pre-authorized_code",
          "authorization_code"
        ],
        "response_types_supported": [
          "code"
        ],
        "code_challenge_methods_supported": [
          "S256"
        ],
        "pre-authorized_grant_anonymous_access_supported": true
      }
    },
    {
      "operation": "get_org_credential_manager_as_metadata",
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server/org/org-a/credential-manager",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "issuer": "https://issuer.example/org/org-a/credential-manager",
        "authorization_endpoint": "https://issuer.example/v1/issuance/authorize?issuer_org=org-a",
        "token_endpoint": "https://issuer.example/v1/issuance/token",
        "pushed_authorization_request_endpoint": "https://issuer.example/v1/issuance/par?issuer_org=org-a",
        "token_endpoint_auth_methods_supported": [
          "none",
          "private_key_jwt"
        ],
        "token_endpoint_auth_signing_alg_values_supported": [
          "ES256"
        ],
        "grant_types_supported": [
          "urn:ietf:params:oauth:grant-type:pre-authorized_code",
          "authorization_code"
        ],
        "response_types_supported": [
          "code"
        ],
        "code_challenge_methods_supported": [
          "S256"
        ],
        "pre-authorized_grant_anonymous_access_supported": true
      }
    },
    {
      "operation": "get_org_apple_wallet_as_metadata",
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server/org/org-a/apple-wallet",
      "status_code": 200,
      "content_type": "application/json",
      "body": {
        "issuer": "https://issuer.example/org/org-a/apple-wallet",
        "authorization_endpoint": "https://issuer.example/v1/issuance/authorize?issuer_org=org-a",
        "token_endpoint": "https://issuer.example/v1/issuance/token",
        "pushed_authorization_request_endpoint": "https://issuer.example/v1/issuance/par?issuer_org=org-a",
        "token_endpoint_auth_methods_supported": [
          "none",
          "private_key_jwt"
        ],
        "token_endpoint_auth_signing_alg_values_supported": [
          "ES256"
        ],
        "grant_types_supported": [
          "urn:ietf:params:oauth:grant-type:pre-authorized_code",
          "authorization_code"
        ],
        "response_types_supported": [
          "code"
        ],
        "code_challenge_methods_supported": [
          "S256"
        ],
        "pre-authorized_grant_anonymous_access_supported": true
      }
    }
  ],
  "rejected_paths": [
    "/.well-known/openid-credential-issuer/org/org-a/spruce",
    "/.well-known/oauth-authorization-server/org/org-a/spruce"
  ],
  "remaining_tenant_backed_operations": [
    "get_org_issuer_metadata",
    "get_org_issuer_metadata_credential_manager",
    "get_org_issuer_metadata_apple_wallet"
  ]
}
