{
  "schema": "marty.issuance-internal-applications/v1",
  "purpose": "Language-neutral behavior and security floor for replacing the Python internal Application lifecycle with the shared Rust issuance service",
  "source_revision": {
    "repository": "ElevenID/marty-credentials",
    "baseline": "f127f55b",
    "approved_repairs": [
      "9907d99: read issuance state from IssuanceTransaction while applications remain approved",
      "843c0e5: restore name, email, then generated applicant identifier precedence",
      "073b177: redact provider transport exception details from external evidence API responses",
      "877253d: reserve replayed application offers idempotently",
      "1dda8ac: map invalid status filters to a stable validation response",
      "3bee6f7: fail closed on missing offer dependencies and issuer context",
      "validate active tenant-owned revocation bindings before ordinary approval",
      "commit manual lifecycle transitions and non-Canvas issuance reservations atomically",
      "commit external-evidence and reconciliation application, fact, transaction, and audit write sets atomically"
    ]
  },
  "coverage": {
    "implemented_case_groups": [
      "surface",
      "authentication",
      "tenant_boundary",
      "request_models",
      "typed_response_projection",
      "lifecycle_success_and_invalid_state_transitions",
      "dependency_failure_matrix",
      "manual_transition_failure_atomicity",
      "offer_replay_and_concurrency",
      "external_api_failure_and_secret_redaction",
      "canvas_and_non_canvas_approval_lifecycle",
      "complete_http_success_lifecycle_replay",
      "external_evidence_concurrent_lifecycle_write_set",
      "reconciliation_concurrent_lifecycle_write_set",
      "external_evidence_failure_injection_and_postgres_write_set_replay",
      "reconciliation_failure_injection_and_postgres_write_set_replay"
    ],
    "required_before_rust_implementation": [],
    "rust_implementation_authorized": true
  },
  "surface": {
