{
  "schema": "marty.issuance-credential-signing/v1",
  "inputs": {
    "path": "/v1/issuance/credential",
    "transaction_id": "tx-signing-contract",
    "organization_id": "org-a",
    "access_token": "access-token-signing",
    "proof_nonce": "proof-nonce-signing",
    "proof_audience": "https://issuer.example/org/org-a",
    "holder_did": "did:key:contract-holder",
    "issuer_did": "did:web:issuer.example",
    "notification_id": "00000000-0000-4000-8000-000000000002"
  },
  "claim_policy": {
    "excluded": [
      "credential_offer_uri",
      "credential_offer_uris",
      "offer_expires_at",
      "issuance_transaction_id",
      "issuance_fallback",
      "credential_type",
      "credential_display_name",
      "rejection_reason",
      "review_notes",
      "info_requests",
      "applicant_id",
      "_vct",
      "_credential_subject",
      "_credential_document"
    ],
    "preserved_fixture": {"achievement": "Portable Canvas", "level": 3},
    "sd_jwt_default_disclosures": ["achievement", "level"]
  },
  "identity": {
    "strategy": "uuid-v5-url-namespace-from-transaction-id",
    "precedence": ["reserved_credential_id", "credential_document.id", "stable_transaction_id"],
    "builder_must_return_reserved_id": true
  },
  "critical_order": [
    "verify_proof",
    "consume_nonce",
    "canvas_readiness",
    "claim_transaction_for_signing",
    "allocate_status",
    "credential_builder",
    "issuer_did_sign",
    "finalize_credential_issuance",
    "post_issuance_side_effects"
  ],
  "state_machine": {
    "claim": {"from": "authorized", "to": "signing", "single_winner": true},
    "finalize": {"from": "signing", "to": "issued", "nonce": null},
    "concurrent_loser": {
      "status_code": 409,
      "body": {
        "error": "issuance_in_progress",
        "error_description": "Credential signing is already in progress for this transaction"
      },
      "may_sign": false
    },
    "issued_retry_returns_canonical_credential": true
  },
  "authorization_code_only": {
    "authorization_session_id": "authorization-session-race",
    "transaction_id": "dca62a6b-abc0-590d-906b-2582303615e5",
    "transaction_identity": "uuid-v5-url-namespace-from-authorization-session-id",
    "requires_active_did_issuer_identity": true,
    "credential_configuration_must_be_granted_by_session": true,
    "concurrent_requests_create_one_transaction": true,
    "concurrent_requests_execute_one_builder": true,
    "concurrent_requests_execute_one_issuer_sign": true,
    "loser": "state_machine.concurrent_loser"
  },
  "formats": [
    {
      "name": "sd_jwt",
      "credential_type": "OpenBadgeCredential",
      "payload_format": "w3c_vcdm_v2_sd_jwt",
      "credential_configuration_id": "OpenBadgeCredential#sd-jwt",
      "effective_request_format": "dc+sd-jwt",
      "remote_credential_format": "dc+sd-jwt",
      "signing_format": "vc+sd-jwt",
      "builder": "sd_jwt",
      "algorithm": "ES256",
      "holder_jwk_required": false,
      "holder_did_required": true,
      "response_format": "dc+sd-jwt"
    },
    {
      "name": "jwt_vc_json",
      "credential_type": "EmployeeCredential",
      "payload_format": "jwt_vc_json",
      "credential_configuration_id": "EmployeeCredential",
      "effective_request_format": "jwt_vc_json",
      "remote_credential_format": "jwt_vc_json",
      "signing_format": "jwt_vc_json",
      "builder": "jwt_vc",
      "algorithm": "ES256",
      "holder_jwk_required": false,
      "holder_did_required": true,
      "response_format": "jwt_vc_json"
    },
    {
      "name": "data_integrity",
      "credential_type": "EmployeeCredential",
      "payload_format": "w3c_vcdm_v2_di",
      "credential_configuration_id": "EmployeeCredential#ldp-vc",
      "effective_request_format": "ldp_vc",
      "remote_credential_format": "ldp_vc",
      "signing_format": "ldp_vc",
      "builder": "data_integrity",
      "algorithm": "EdDSA",
      "credential_document_id": "urn:uuid:contract-data-integrity-document",
      "holder_jwk_required": false,
      "holder_did_required": true,
      "response_format": "ldp_vc"
    },
    {
      "name": "mso_mdoc",
      "credential_type": "org.iso.18013.5.1.mDL",
      "payload_format": "mso_mdoc",
      "credential_configuration_id": "org.iso.18013.5.1.mDL#mdoc",
      "effective_request_format": "mso_mdoc",
      "remote_credential_format": "mso_mdoc",
      "signing_format": "mso_mdoc",
      "builder": "mdoc",
      "algorithm": "ES256",
      "holder_jwk_required": true,
      "holder_did_required": false,
      "response_format": "mso_mdoc"
    }
  ]
}
