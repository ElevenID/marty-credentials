{
  "schema": "marty.issuance-credential-lifecycle/v1",
  "scope": {
    "http": [
      {
        "method": "POST",
        "path": "/v1/issuance/credentials/{credential_id}/revoke",
        "operation": "revoke_credential"
      },
      {
        "method": "POST",
        "path": "/v1/issuance/credentials/{credential_id}/suspend",
        "operation": "suspend_credential"
      },
      {
        "method": "POST",
        "path": "/v1/issuance/credentials/{credential_id}/reinstate",
        "operation": "reinstate_credential"
      },
      {
        "method": "GET",
        "path": "/v1/issuance/credentials/{credential_id}/status",
        "operation": "get_credential_status"
      }
    ],
    "grpc": [
      "RevokeCredential",
      "SuspendCredential",
      "ReinstateCredential",
      "GetCredentialStatus"
    ],
    "authentication": {
      "http": "management-api-key-and-trusted-organization",
      "grpc": "service-token"
    }
  },
  "request": {
    "reason": {
      "required": false,
      "nullable": true,
      "maximum_characters": 2000
    }
  },
  "transitions": [
    {
      "action": "revoke",
      "from": ["active", "suspended"],
      "to": "revoked",
      "terminal": true
    },
    {
      "action": "suspend",
      "from": ["active", "suspended"],
      "to": "suspended",
      "terminal": false
    },
    {
      "action": "reinstate",
      "from": ["suspended"],
      "to": "active",
      "terminal": false
    }
  ],
  "mutation_order": [
    "load-credential",
    "enforce-resource-organization-when-http",
    "validate-transition",
    "publish-revocation-profile-status",
    "persist-local-status",
    "synchronize-canvas-delivery-records",
    "emit-grpc-stream-event",
    "return-response"
  ],
  "publication": {
    "revocation_profile": "required-before-local-persistence",
    "canvas_delivery_records": "after-local-persistence-with-failure-recorded-for-retry",
    "grpc_stream_event": "after-canonical-handler-success"
  },
  "failures": [
    {
      "name": "credential_not_found",
      "http_status": 404,
      "grpc_status": "NOT_FOUND",
      "detail": "Credential not found"
    },
    {
      "name": "revoke_already_revoked",
      "http_status": 400,
      "grpc_status": "FAILED_PRECONDITION",
      "detail": "Credential already revoked"
    },
    {
      "name": "suspend_revoked",
      "http_status": 400,
      "grpc_status": "FAILED_PRECONDITION",
      "detail": "Cannot suspend revoked credential"
    },
    {
      "name": "reinstate_revoked",
      "http_status": 400,
      "grpc_status": "FAILED_PRECONDITION",
      "detail": "Cannot reinstate revoked credential"
    },
    {
      "name": "reinstate_not_suspended",
      "http_status": 400,
      "grpc_status": "FAILED_PRECONDITION",
      "detail": "Only suspended credentials can be reinstated"
    },
    {
      "name": "revocation_publication_unavailable",
      "http_status": 503,
      "grpc_status": "INTERNAL",
      "local_status_changes": 0,
      "stream_events": 0
    }
  ],
  "response": {
    "fields": ["id", "status", "status_updated_at", "reason"],
    "http_additional_fields": ["issuer_did"],
    "status_values": ["active", "suspended", "revoked"],
    "timestamp": "iso-8601-with-offset"
  },
  "security_invariants": [
    "wrong-organization-http-resources-are-hidden-as-not-found",
    "revocation-profile-failure-never-leaves-local-success",
    "http-and-grpc-mutations-use-one-canonical-handler",
    "stream-events-are-never-emitted-for-failed-mutations"
  ]
}
