  "operations": [
    {"method": "GET", "path": "/v1/passport/capabilities", "outcome": "readiness-with-blockers"},
    {"method": "POST", "path": "/v1/passport/applications", "outcome": "DRAFT", "effect": "encrypted-artifact-insert"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/generate-data-groups", "outcome": "DATA_GENERATED", "effect": "status-update"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/generate-sod", "outcome": "SOD_SIGNED", "effect": "signed-sod-hash-update"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/submit-personalization", "outcome": "SUBMITTED", "effect": "bureau-submission-update"},
    {"method": "GET", "path": "/v1/passport/applications/{application_id}/production-status", "outcome": "IN_PRODUCTION", "effect": "conditional-bureau-poll"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/quality-verify", "outcome": "READY_FOR_ACTIVATION", "effect": "quality-audit-update"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/activate", "outcome": "ACTIVE", "effect": "artifact-scrub-update"},
    {"method": "POST", "path": "/v1/passport/webhooks/personalization", "outcome": "accepted", "effect": "signed-bureau-event-update"}
  ],
  "negative_observations": {
    "quality_before_bureau_ready": {"status": 409, "detail": "Document is not ready for quality verification"},
    "activation_without_passing_quality": {"status": 409, "detail": "A passing quality result is required before activation"},
    "invalid_webhook_signature": {"status": 401, "detail": "Invalid personalization webhook signature"},
    "unknown_webhook_job": {"status": 404, "detail": "Physical document job not found"}
