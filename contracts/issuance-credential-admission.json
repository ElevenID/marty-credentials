{
  "schema": "marty.issuance-credential-admission/v1",
  "inputs": {
    "path": "/v1/issuance/credential",
    "transaction_id": "tx-credential",
    "organization_id": "org-a",
    "access_token": "access-token-credential",
    "credential_configuration_id": "OpenBadgeCredential#sd-jwt",
    "credential_type": "OpenBadgeCredential",
    "proof_nonce": "proof-nonce-credential",
    "proof_audience": "https://issuer.example/org/org-a",
    "notification_id": "00000000-0000-4000-8000-000000000001"
  },
  "cases": [
    {
      "name": "missing_authorization",
      "setup": "authorized_transaction",
      "authorization": null,
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "Missing or invalid authorization"},
      "repository_calls": []
    },
    {
      "name": "invalid_authorization_scheme",
      "setup": "authorized_transaction",
      "authorization": "Basic opaque",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "Missing or invalid authorization"},
      "repository_calls": []
    },
    {
      "name": "invalid_access_token",
      "setup": "missing_transaction",
      "authorization": "Bearer missing-token",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "Invalid access token"},
      "repository_calls": [
        {"method": "get_by_access_token", "value": "missing-token"},
        {"method": "get_authorization_session_by_access_token", "value": "missing-token"}
      ]
    },
    {
      "name": "selector_is_required",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_credential_request", "error_description": "Provide exactly one of credential_configuration_id or credential_identifier"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "selectors_are_mutually_exclusive",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "credential_identifier": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_credential_request", "error_description": "Provide exactly one of credential_configuration_id or credential_identifier"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "issued_retry_returns_canonical_credential",
      "setup": "issued_with_credential",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 200,
      "body": {"credentials": [{"format": "dc+sd-jwt", "credential": "signed-credential"}], "notification_id": "00000000-0000-4000-8000-000000000001"},
      "repository_calls": [
        {"method": "get_by_access_token", "value": "access-token-credential"},
        {"method": "get_credential_by_transaction_id", "value": "tx-credential"}
      ]
    },
    {
      "name": "issued_without_canonical_record_is_rejected",
      "setup": "issued_without_credential",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_credential_request", "error_description": "Credential already issued \u2014 access token is single-use"},
      "repository_calls": [
        {"method": "get_by_access_token", "value": "access-token-credential"},
        {"method": "get_credential_by_transaction_id", "value": "tx-credential"}
      ]
    },
    {
      "name": "transaction_must_be_authorized",
      "setup": "pending_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_credential_request", "error_description": "Invalid transaction state"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "unknown_configuration",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OtherCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "unknown_credential_configuration", "error_description": "Unknown credential_configuration_id: 'OtherCredential#sd-jwt'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "pre_authorized_flow_rejects_credential_identifier",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_identifier": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "unknown_credential_identifier", "error_description": "Unknown credential_identifier: 'OpenBadgeCredential#sd-jwt'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_is_required",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "Proof of possession is required per OID4VCI \u00a77.2"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "malformed_proof_audience",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "malformed"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "Could not decode proof JWT audience"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_is_tenant_bound",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "wrong_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'https://issuer.example/org/other'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_prefixed_tenant_path",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "prefixed_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'https://issuer.example/evil/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_alternate_scheme",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "alternate_scheme_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'http://issuer.example/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_alternate_host",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "alternate_host_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'https://other.example/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_unconfigured_port",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "alternate_port_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'https://issuer.example:444/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_userinfo_confusion",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "userinfo_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got 'https://issuer.example@other.example/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_audience_rejects_relative_url",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "relative_audience"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "OID4VCI \u00a78.2: proof JWT aud MUST be the credential_issuer URL (path in ('/org/org-a', '/org/org-a/credential-manager', '/org/org-a/apple-wallet', '/org/org-a/waltid')), got '/org/org-a'"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_nonce_is_required",
      "setup": "authorized_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "missing_nonce"},
      "status_code": 400,
      "body": {"error": "invalid_nonce", "error_description": "Proof nonce is missing, expired, or already used"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "invalid_signature_does_not_consume_nonce",
      "setup": "invalid_signature",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_proof", "error_description": "invalid signature"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "proof_nonce_is_single_use",
      "setup": "nonce_replayed",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 400,
      "body": {"error": "invalid_nonce", "error_description": "Proof nonce is missing, expired, or already used"},
      "repository_calls": [
        {"method": "get_by_access_token", "value": "access-token-credential"},
        {"method": "consume_proof_nonce", "value": "proof-nonce-credential"}
      ]
    },
    {
      "name": "proof_nonce_store_fails_closed",
      "setup": "nonce_store_unavailable",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 503,
      "body": {"error": "temporarily_unavailable", "error_description": "Proof nonce storage is unavailable"},
      "repository_calls": [
        {"method": "get_by_access_token", "value": "access-token-credential"},
        {"method": "consume_proof_nonce", "value": "proof-nonce-credential"}
      ]
    },
    {
      "name": "dpop_bound_token_requires_proof",
      "setup": "dpop_bound_transaction",
      "authorization": "Bearer access-token-credential",
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "DPoP proof is required for this access token"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "invalid_dpop_proof",
      "setup": "dpop_bound_transaction",
      "authorization": "Bearer access-token-credential",
      "headers": {"DPoP": "invalid-dpop"},
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "Invalid DPoP proof"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    },
    {
      "name": "dpop_key_must_match_access_token",
      "setup": "dpop_bound_transaction",
      "authorization": "Bearer access-token-credential",
      "headers": {"DPoP": "other-dpop"},
      "request": {"credential_configuration_id": "OpenBadgeCredential#sd-jwt", "proof": "valid"},
      "status_code": 401,
      "body": {"detail": "DPoP proof does not match access token"},
      "repository_calls": [{"method": "get_by_access_token", "value": "access-token-credential"}]
    }
  ]
}
